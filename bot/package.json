{
  "name": "daxvssql-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone runner that reproduces the IC Insightful BOT loop with a pluggable query tool per test arm (DAX vs SQL POC).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bot": "tsx src/cli.ts"
  },
  "dependencies": {
    "@upstash/vector": "^1.2.3",
    "mysql2": "^3.24.6",
    "node-sql-parser": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
